# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used only in app/api/events/route.ts
# to record anonymous recipient events (opened, gift_opened, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit — for photo/music uploads
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Used to build the shareable /birthday/[slug] link on the success screen.
# Set to your deployed domain in production (e.g. https://birthzme.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
